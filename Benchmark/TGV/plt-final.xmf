<?xml version="1.0" ?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf xmlns:xi="http://www.w3.org/2003/XInclude" Version="2.2">
 <Domain>
  <Grid Name="Grid" GridType="Uniform">
  <Time Value="1.0" />
   <Topology TopologyType="3DSMesh" NumberOfElements="65 65 65" />
   <Geometry GeometryType="XYZ">
   <DataItem Name="coords" Dimensions="65 65 65 3" NumberType="Float" Precision="4" Format="HDF">
    tgv_mesh.h5:/coords
   </DataItem>
   </Geometry>
   <Attribute Name="rho" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/rho
   </DataItem>
   </Attribute>
   <Attribute Name="u" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/u
   </DataItem>
   </Attribute>
   <Attribute Name="v" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/v
   </DataItem>
   </Attribute>
   <Attribute Name="w" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/w
   </DataItem>
   </Attribute>
   <Attribute Name="p" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/p
   </DataItem>
   </Attribute>
   <Attribute Name="T" AttributeType="Scalar" Center="Cell">
    <DataItem Dimensions="64 64 64" NumberType="Float" Precision="4" Format="HDF">
    plt-final.h5:/T
   </DataItem>
   </Attribute>
   <Attribute Name="phi" AttributeType="Scalar" Center="Cell">
